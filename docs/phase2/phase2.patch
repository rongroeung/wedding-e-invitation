+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+  translate: 0 0;
+  transition:
+    translate var(--fl-near-t, 1200ms) cubic-bezier(0.55, 0, 0.8, 0.25),
+    opacity var(--fl-near-t, 1200ms) ease-in;
