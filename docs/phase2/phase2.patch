+/* ══ The flap envelope ═══════════════════════════════════════════════════════
+ *
+ * Unlayered on purpose: these follow, and override, the gatefold's sizing in
+ * `@layer components` above without editing it.
+ *
+ * The piece is landscape now — a real envelope, 1.42 wide for every 1 tall —
+ * and about 86% of a phone's width. Its width is still fitted to the height
+ * left between the furniture above and below it (`--env-chrome`), for the same
+ * reason the gatefold's was: type and touch targets do not shrink with the
+ * screen, so the envelope is what gives.
+ */
+.env-piece {
+  --env-w: clamp(220px, min(86vw, (100vh - var(--env-chrome, 330px)) * 1.42), 600px);
+  width: var(--env-w);
+  height: calc(var(--env-w) / 1.42);
+  font-size: calc(var(--env-w) / 26);
+}
+@supports (height: 100dvh) {
+  .env-piece {
+    --env-w: clamp(220px, min(86vw, (100dvh - var(--env-chrome, 330px)) * 1.42), 600px);
+  }
+}
