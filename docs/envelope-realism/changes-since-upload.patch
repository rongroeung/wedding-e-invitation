 }
+
+/* ══ The envelope: a small physical scene ════════════════════════════════════
+ *
+ * Unlayered on purpose: these follow, and override, the gatefold's sizing in
+ * `@layer components` above without editing it.
+ *
+ * One key light, from the upper left. Every highlight is on an upper-left
+ * edge and every shadow falls down and to the right; nothing has an outline.
+ * Paper is a flat colour from the envelope style, modulated by a neutral,
+ * seamless relief map (`paper-cotton`, `paper-card`, `paper-lining-fine`)
+ * through `overlay`, so any style keeps the same tooth.
+ *
+ * Sizes are in `em` against the piece (1em = 1/26 of its width), so the whole
+ * object scales as one from a 320px phone to a desktop.
+ */
+.env-piece {
+  --env-w: clamp(220px, min(86vw, (100vh - var(--env-chrome, 330px)) * 1.42), 600px);
+  width: var(--env-w);
+  height: calc(var(--env-w) / 1.42);
+  font-size: calc(var(--env-w) / 26);
+}
+@supports (height: 100dvh) {
+  .env-piece {
+    --env-w: clamp(220px, min(86vw, (100dvh - var(--env-chrome, 330px)) * 1.42), 600px);
+  }
+}
+
+/* `.env-piece` is a flattening element (it isolates and is moved by the
+   camera), so the scene brings its own perspective and world inside it. */
+.pe {
+  position: absolute;
+  inset: 0;
+  /* close enough that a flap turning toward the camera keystones visibly —
+     at 2200px the turn read as a flat squash */
+  perspective: 1000px;
+  perspective-origin: 50% 30%;
+  --pe-paper: url(/kit/paper-cotton.webp);
+  /* the key light, in envelope coordinates: brighter toward the upper left,
+     falling off toward the lower right. Laid over every full-size surface. */
+  --pe-key:
+    radial-gradient(120% 95% at 12% 6%, rgb(255 250 246 / 0.26), rgb(255 250 246 / 0.06) 48%, transparent 70%),
+    linear-gradient(135deg, transparent 45%, rgb(70 30 40 / 0.1));
+}
+.pe-world,
+.pe-body {
+  position: absolute;
+  inset: 0;
+  transform-style: preserve-3d;
+}
+.pe-body {
+  transform: translate3d(0, 0, 0);
+  transition: transform var(--pe-card-t, 1600ms) cubic-bezier(0.45, 0.05, 0.3, 1);
+}
+/* drawing the card out pulls the envelope down a little with it */
+.pe-card-out .pe-body { transform: translate3d(0, 4%, 0); }
+/* and then it drops out of the shot */
+.pe-lowered .pe-body {
+  transform: translate3d(0, 165%, 0);
+  /* a gentle drop: it lets go, then falls clear before the room goes dark */
+  transition: transform calc(var(--pe-near-t, 1300ms) * 0.8) cubic-bezier(0.45, 0, 0.6, 1);
+}
+
+/* ── The envelope's shadow on the table ─────────────────────────────────── */
+.pe-table-shadow {
+  position: absolute;
+  left: 4%;
+  right: -2%;
+  top: 9%;
+  bottom: -5%;
+  border-radius: 6%;
+  transform: translateZ(-2px);
+  background: radial-gradient(closest-side, rgb(20 6 10 / 0.6), rgb(20 6 10 / 0.25) 70%, transparent);
+  filter: blur(1em);
+  transition: opacity var(--pe-near-t, 1300ms) ease-in, transform var(--pe-card-t, 1600ms) ease;
+}
+.pe-card-out .pe-table-shadow { transform: translate3d(0, 4%, -2px); }
+.pe-lowered .pe-table-shadow { opacity: 0; }
+
+/* ── z 0 · rear panel ───────────────────────────────────────────────────── */
+.pe-back {
+  position: absolute;
+  inset: 0;
+  border-radius: 0.14em;
+  transform: translateZ(0);
+  background:
+    linear-gradient(135deg, rgb(255 255 255 / 0.1), transparent 45%, rgb(60 25 30 / 0.08)),
+    var(--pe-paper) 0 0 / 18em,
+    var(--env-paper-shade);
+  background-blend-mode: normal, overlay, normal;
+  box-shadow:
+    0 0 0 0.5px rgb(90 50 50 / 0.16),
+    0.05em 0.07em 0 0 var(--env-paper-deep),
+    0.1em 0.16em 0.25em rgb(40 15 20 / 0.32),
+    0.45em 0.75em 1.7em -0.2em rgb(30 10 15 / 0.32);
+}
+/* the inside, seen only when the flap is open: the same paper in shade,
+   darkest under the hinge where least light reaches */
+.pe-back-inside {
+  position: absolute;
+  inset: 0.3em 0.3em 0.2em;
+  border-radius: 0.1em;
+  background:
+    linear-gradient(180deg, rgb(50 20 25 / 0.34), rgb(50 20 25 / 0.12) 34%, rgb(50 20 25 / 0.04) 70%),
+    linear-gradient(90deg, rgb(50 20 25 / 0.1), transparent 22%, transparent 78%, rgb(50 20 25 / 0.14)),
+    var(--pe-paper) 7em 3em / 18em,
+    var(--env-paper-deep);
+  background-blend-mode: normal, normal, overlay, normal;
+}
+/* the fold along the top edge, where the flap is joined to the back */
+.pe-hinge {
+  position: absolute;
+  left: 0.2em;
+  right: 0.2em;
+  top: 0;
+  height: 0.16em;
+  background: linear-gradient(180deg, rgb(255 255 255 / 0.32), rgb(80 40 45 / 0.22));
+}
+
+/* ── z 3 · the pocket ───────────────────────────────────────────────────── */
+.pe-pocket {
+  position: absolute;
+  inset: 0;
+  transform: translateZ(3px);
+}
+/* each fold casts onto what is under it — down and to the right, short and
+   soft — through a drop-shadow that follows the fold's own shape */
+.pe-fold-wrap {
+  position: absolute;
+  inset: 0;
+  filter:
+    drop-shadow(0.03em 0.06em 0.04em rgb(70 25 35 / 0.34))
+    drop-shadow(0.1em 0.18em 0.32em rgb(70 25 35 / 0.14));
+}
+.pe-fold {
+  position: absolute;
+  inset: 0;
+  background-blend-mode: normal, normal, normal, overlay, normal;
+}
+/* faces turned toward the light are a touch lighter, away a touch darker */
+.pe-fold-left {
+  background:
+    var(--pe-key),
+    linear-gradient(100deg, rgb(255 255 255 / 0.2), rgb(255 255 255 / 0.07) 45%, rgb(80 35 40 / 0.04)),
+    var(--pe-paper) 3em 1em / 18em,
+    var(--env-paper);
+}
+.pe-fold-right {
+  background:
+    var(--pe-key),
+    linear-gradient(260deg, rgb(80 35 40 / 0.16), rgb(80 35 40 / 0.07) 50%, rgb(80 35 40 / 0.02)),
+    var(--pe-paper) 11em 5em / 18em,
+    var(--env-paper);
+}
+.pe-fold-bottom {
+  background:
+    var(--pe-key),
+    linear-gradient(172deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.02) 45%, rgb(80 35 40 / 0.06)),
+    var(--pe-paper) 5em 9em / 18em,
+    var(--env-paper);
+}
+.pe-contours {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+.pe-contours polyline {
+  fill: none;
+  vector-effect: non-scaling-stroke;
+  stroke-linejoin: round;
+  stroke-linecap: round;
+}
+.pe-edge-lit  { stroke: rgb(255 250 248 / 0.7); stroke-width: 1; }
+.pe-edge-soft { stroke: rgb(255 250 248 / 0.35); stroke-width: 0.9; }
+.pe-edge-dark { stroke: rgb(90 35 45 / 0.22); stroke-width: 0.9; }
+
+/* the closed flap's shadow on the pocket: separates and softens as it lifts */
+.pe-flap-shade-wrap {
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: 0;
+  height: 58%;
+  filter: blur(0.1em);
+  transform: translate(0.05em, 0.12em);
+  transition:
+    transform calc(var(--pe-flap-t, 1400ms) * 0.45) ease-in,
+    opacity calc(var(--pe-flap-t, 1400ms) * 0.45) ease-in,
+    filter calc(var(--pe-flap-t, 1400ms) * 0.45) ease-in;
+}
+.pe-flap-shade {
+  position: absolute;
+  inset: 0;
+  background: rgb(70 25 35 / 0.38);
+}
+.pe-open .pe-flap-shade-wrap {
+  opacity: 0;
+  transform: translate(0.3em, 0.9em);
+  filter: blur(0.6em);
+}
+
+/* ── z 4 → −1 · the flap ────────────────────────────────────────────────── *
+ * Hinged on its top edge. `transform-origin` puts the axis 2.5px behind the
+ * flap's plane — at z 1.5 once the flap's own translateZ(4px) is applied — so
+ * a half turn lands it at z −1: behind the card, in front of nothing it should
+ * cover. Positive rotateX brings the point toward the camera first, as a flap
+ * lifted by hand does. */
+.pe-flap {
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: 0;
+  height: 58%;
+  transform-style: preserve-3d;
+  transform-origin: 50% 0 -2.5px;
+  transform: translateZ(4px) rotateX(0deg);
+  transition: transform var(--pe-flap-t, 1400ms) cubic-bezier(0.5, 0.02, 0.22, 1);
+}
+.pe-open .pe-flap { transform: translateZ(4px) rotateX(180deg); }
+
+/* The light on the flap changes as it turns. The outside turns its face down
+   and away from the key light as it rises to upright — the half of the turn
+   in which it can be seen — and the lining comes round out of that shade into
+   the light over the other half. Transitions, not keyframes: a keyframe
+   animation applies its easing per segment, which put the shading out of step
+   with the turn. The 90° moment on this curve is at 45% of its time. */
+.pe-flap-out::before,
+.pe-flap-in::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+  pointer-events: none;
+  background: linear-gradient(180deg, rgb(40 12 20 / 0.5), rgb(40 12 20 / 0.32));
+}
+.pe-flap-out::before {
+  opacity: 0;
+  transition: opacity calc(var(--pe-flap-t, 1400ms) * 0.45) cubic-bezier(0.55, 0, 0.9, 0.5);
+}
+.pe-flap-in::before {
+  opacity: 0.6;
+  transition: opacity calc(var(--pe-flap-t, 1400ms) * 0.55) cubic-bezier(0.1, 0.5, 0.3, 1) calc(var(--pe-flap-t, 1400ms) * 0.45);
+}
+.pe-open .pe-flap-out::before { opacity: 0.6; }
+.pe-open .pe-flap-in::before { opacity: 0; }
+
+.pe-flap-out,
+.pe-flap-in {
+  position: absolute;
+  inset: 0;
+  -webkit-backface-visibility: hidden;
+  backface-visibility: hidden;
+  background-blend-mode: normal, overlay, normal;
+}
+.pe-flap-out {
+  background:
+    /* the fold along the top catches the light */
+    linear-gradient(180deg, rgb(255 252 248 / 0.4), rgb(255 252 248 / 0) 2.2%),
+    radial-gradient(120% 160% at 12% 6%, rgb(255 250 246 / 0.28), rgb(255 250 246 / 0.06) 50%, transparent 72%),
+    linear-gradient(162deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03) 40%, rgb(80 35 40 / 0.07)),
+    var(--pe-paper) 2em 0 / 18em,
+    var(--env-paper);
+  background-blend-mode: normal, normal, normal, overlay, normal;
+}
+/* the cut edge of the flap faces away from the light: a fine shade along it */
+.pe-flap-edge {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+.pe-flap-edge polyline {
+  fill: none;
+  stroke: rgb(90 35 45 / 0.28);
+  stroke-width: 1.4;
+  vector-effect: non-scaling-stroke;
+}
+/* the lining: the flap's other face — same piece, same hinge — warmer cream,
+   finer paper, a little shade along the fold */
+.pe-flap-in {
+  transform: rotateY(180deg);
+  background:
+    linear-gradient(180deg, rgb(80 50 30 / 0.2), rgb(80 50 30 / 0.04) 22%, transparent 60%),
+    url(/kit/paper-lining-fine.webp) 0 0 / 16em,
+    #f2e5cf;
+}
+.pe-foil,
+.pe-lining-rule {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+.pe-foil polyline {
+  fill: none;
+  stroke-width: 1.3;
+  vector-effect: non-scaling-stroke;
+  stroke-linejoin: round;
+}
+.pe-lining-rule polyline {
+  fill: none;
+  stroke: rgb(176 140 90 / 0.5);
+  stroke-width: 0.9;
+  vector-effect: non-scaling-stroke;
+}
+.pe-flap-mono {
+  position: absolute;
+  left: 50%;
+  top: 18%;
+  width: 17%;
+  transform: translateX(-50%);
+}
+
+/* the couple's own artwork, printed on the outside of the paper */
+.pe-has-art .pe-fold::after,
+.pe-has-art .pe-flap-out::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: var(--pe-art) center / cover no-repeat;
+  opacity: calc(1 - var(--pe-art-scrim, 0));
+  pointer-events: none;
+}
+.pe-has-art .pe-flap-out::after {
+  bottom: auto;
+  height: calc(100% / 0.58);
+}
+
+/* ── z 1 · the card ─────────────────────────────────────────────────────── */
+.pe-card {
+  position: absolute;
+  left: 6.5%;
+  right: 6.5%;
+  top: 4.5%;
+  height: 90%;
+  transform: translate3d(0, 0, 1px);
+  transition: transform var(--pe-card-t, 1600ms) cubic-bezier(0.42, 0, 0.2, 1);
+}
+.pe-card-face {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  height: 100%;
+  padding: 5% 9%;
+  border-radius: 0.12em;
+  text-align: center;
+  background:
+    linear-gradient(150deg, rgb(255 255 255 / 0.35), transparent 40%, rgb(120 90 60 / 0.06)),
+    url(/kit/paper-card.webp) 0 0 / 16em,
+    #fbf5ea;
+  background-blend-mode: normal, overlay, normal;
+  box-shadow:
+    inset 0.03em 0.03em 0 rgb(255 255 255 / 0.8),
+    inset -0.03em -0.04em 0 rgb(170 140 100 / 0.3),
+    0.03em 0.05em 0 #e2d4bd,
+    0.08em 0.14em 0.3em rgb(60 30 30 / 0.2);
+  transition: box-shadow var(--pe-card-t, 1600ms) ease;
+}
+.pe-card-face::after {
+  content: "";
+  position: absolute;
+  inset: 0.55em;
+  border: 1px solid rgb(201 169 110 / 0.55);
+  border-radius: 0.06em;
+  pointer-events: none;
+}
+.pe-card-crest { width: 17%; height: auto; }
+.pe-card-title {
+  margin: 0.1em 0 0;
+  font-family: var(--f-heading), "Khmer OS Muol Light", serif;
+  font-size: 0.86em;
+  line-height: 2;
+  color: rgb(var(--c-primary-rgb));
+}
+.pe-card .pe-card-names { width: 50%; }
+.pe-card-lead {
+  margin: 0.3em 0 0;
+  font-size: 0.64em;
+  line-height: 1.9;
+  color: rgb(var(--gold-1-rgb));
+}
+/* drawn out by hand: up, a little to the side, a degree and a half of turn;
+   in the air its shadow is longer and softer */
+.pe-card-out .pe-card { transform: translate3d(1.5%, -98%, 1px) rotate(-1.4deg); }
+.pe-card-out .pe-card-face {
+  box-shadow:
+    inset 0.03em 0.03em 0 rgb(255 255 255 / 0.8),
+    inset -0.03em -0.04em 0 rgb(170 140 100 / 0.3),
+    0.03em 0.05em 0 #e2d4bd,
+    0.35em 0.6em 1.1em rgb(30 10 15 / 0.32);
+}
+/* then toward the camera — real depth, so the perspective does the scaling */
+.pe-lowered .pe-card {
+  transform: translate3d(0, -58%, 400px) rotate(0deg);
+  transition: transform var(--pe-near-t, 1300ms) cubic-bezier(0.45, 0, 0.2, 1);
+}
+
+/* ── z 6 · the seal ─────────────────────────────────────────────────────── */
+.pe-seal,
+.pe-seal-shadow {
+  position: absolute;
+  left: 50%;
+  top: 51%;
+  width: 20%;
+  aspect-ratio: 1;
+}
+.pe-seal {
+  transform: translate3d(-50%, -50%, 6px);
+  transition: transform var(--pe-press-t, 300ms) cubic-bezier(0.3, 0, 0.2, 1);
+}
+.pe-wax {
+  position: relative;
+  width: 100%;
+  height: 100%;
+}
+.pe-wax svg {
+  display: block;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+.pe-wax-text {
+  position: absolute;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  font-family: var(--f-heading), "Khmer OS Muol Light", serif;
+  font-size: 1.05em;
+  line-height: 1.9;
+  color: #8a6733;
+  /* pressed in: shade toward the light, a lit lip away from it */
+  text-shadow: -0.03em -0.03em 0 rgb(60 40 15 / 0.55), 0.03em 0.03em 0 rgb(255 240 210 / 0.55);
+}
+.pe-seal-shadow {
+  border-radius: 50%;
+  transform: translate3d(-47%, -45%, 5px) scale(0.98);
+  background: radial-gradient(closest-side, rgb(40 15 10 / 0.5), rgb(40 15 10 / 0.22) 72%, transparent);
+  filter: blur(0.07em);
+  transition: transform var(--pe-press-t, 300ms) ease, filter var(--pe-press-t, 300ms) ease;
+}
+/* pressed: the wax gives a fraction, the shadow tightens under it */
+.pe-pressed .pe-seal { transform: translate3d(-50%, -50%, 5.5px) scale(0.975); }
+.pe-pressed .pe-seal-shadow { transform: translate3d(-48.5%, -47.5%, 5px) scale(0.96); filter: blur(0.04em); }
+/* released, lifted, and carried away by hand — not shrunk, not faded on the
+   spot: it travels, and it only fades once it is off the envelope */
+.pe-lifted .pe-seal { animation: pe-seal-away var(--pe-lift-t, 930ms) cubic-bezier(0.4, 0, 0.3, 1) forwards; }
+.pe-lifted .pe-seal-shadow { animation: pe-seal-shadow-away var(--pe-lift-t, 930ms) cubic-bezier(0.4, 0, 0.3, 1) forwards; }
+@keyframes pe-seal-away {
+  0%   { transform: translate3d(-50%, -50%, 5.5px) scale(0.975); opacity: 1; }
+  12%  { transform: translate3d(-50%, -51%, 9px) scale(1); opacity: 1; }
+  30%  { transform: translate3d(-49%, -60%, 46px) rotate(-2deg); opacity: 1; }
+  82%  { transform: translate3d(230%, -230%, 150px) rotate(-11deg); opacity: 1; }
+  100% { transform: translate3d(330%, -290%, 170px) rotate(-13deg); opacity: 0; }
+}
+@keyframes pe-seal-shadow-away {
+  0%   { transform: translate3d(-48.5%, -47.5%, 5px) scale(0.96); filter: blur(0.04em); opacity: 1; }
+  12%  { transform: translate3d(-46%, -44%, 5px) scale(1.02); filter: blur(0.12em); opacity: 0.9; }
+  30%  { transform: translate3d(-38%, -34%, 5px) scale(1.12); filter: blur(0.4em); opacity: 0.55; }
+  60%  { transform: translate3d(10%, -60%, 5px) scale(1.2); filter: blur(0.8em); opacity: 0; }
+  100% { opacity: 0; }
+}
+
+/* ── The set: dusk, a heading, and light type ──────────────────────────── */
+.room-dusk {
+  position: absolute;
+  inset: 0;
+  background: radial-gradient(120% 92% at 50% 36%, #5c3644 0%, #2e1b23 52%, #150c10 100%);
+}
+.room-dusk-photo {
+  inset: -48px;
+  background:
+    linear-gradient(rgb(22 11 16 / 0.6), rgb(22 11 16 / 0.8)),
+    var(--room-photo) center / cover no-repeat;
+  filter: blur(14px) saturate(0.85);
+}
+.env-lite .room-dusk-photo { filter: blur(8px); }
+
+.env-heading {
+  margin-bottom: clamp(0.2rem, 1.2vh, 0.8rem);
+  padding-inline: 1rem;
+  text-align: center;
+  transition:
+    opacity 700ms ease-out,
+    transform 900ms cubic-bezier(0.4, 0, 0.5, 1);
+}
+.env-heading-gone {
+  opacity: 0;
+  transform: translate3d(0, -0.6rem, 0);
+}
+.env-heading-title {
+  margin: 0;
+  padding-top: 0.15em;
+  font-family: "Moul", var(--f-heading), serif;
+  font-weight: 400;
+  font-size: clamp(1.1rem, 5.6vw, 2rem);
+  line-height: 2.05;
+  color: #f1dfba;
+  text-shadow: 0 1px 0 rgb(0 0 0 / 0.35), 0 0 24px rgb(201 169 110 / 0.28);
+}
+.env-heading-sub {
+  margin: -0.35em 0 0;
+  font-family: "Pinyon Script", cursive;
+  font-size: clamp(1.1rem, 4.8vw, 1.7rem);
+  line-height: 1.5;
+  color: rgb(247 214 222 / 0.88);
+}
+.env-veil .env-address-lead { color: rgb(241 223 186 / 0.86); }
+.env-veil .env-address-name { color: #fbeff2; }
+.env-veil .env-hint { color: rgb(251 239 242 / 0.7); }
+.env-veil .env-skip { color: rgb(251 239 242 / 0.6); }
+.env-veil .env-skip:hover { color: rgb(251 239 242 / 0.95); }
+
+/* The dark beat: the card comes into it, the curtains come out of it. */
+.env-dusk {
+  position: absolute;
+  inset: 0;
+  z-index: 40;
+  background: #0c0608;
+  opacity: 0;
+  pointer-events: none;
+  transition-property: opacity;
+  transition-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
+}
+.env-dusk-on { opacity: 1; }
+
+/* a phone held sideways: pull the camera further back while the card is out,
+   so it never leaves the top of the frame */
+@media (max-height: 520px) and (orientation: landscape) {
+  .env-veil {
+    --pe-cam-card-y: 31%;
+    --pe-cam-card-s: 0.7;
+    --pe-cam-low-y: 24%;
+    --pe-cam-low-s: 0.74;
+  }
+}
+@media (max-height: 620px) {
+  .env-veil { --env-chrome: 190px; }
+  .env-heading-title { font-size: 1rem; line-height: 1.85; }
+  .env-heading-sub { display: none; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .pe-body,
+  .pe-card,
+  .pe-flap,
+  .pe-seal,
+  .pe-flap-shade-wrap { transition-duration: 1ms !important; }
+  .pe-lifted .pe-seal,
+  .pe-lifted .pe-seal-shadow { animation-duration: 1ms !important; }
+  .pe-flap-out::before,
+  .pe-flap-in::before { transition-duration: 1ms !important; transition-delay: 0ms !important; }
+}
+
+/* ══ The couple-name mark ═════════════════════════════════════════════════ */
+.namelogo {
+  position: relative;
+  container-type: inline-size;
+  width: 100%;
+  aspect-ratio: 2 / 1;
+  color: var(--env-gold, rgb(var(--gold-frame-rgb)));
+}
+.namelogo-name {
+  position: absolute;
+  white-space: nowrap;
+  font-family: var(--nl-face, "Moulpali", "Moul", serif);
+  font-weight: 400;
+  font-size: 15cqw;
+  /* Khmer needs room above and below for vowels and subscripts. */
+  line-height: 1.9;
+  padding-block: 0.1em;
+  color: #b8935a;
+  text-shadow: 0 1px 0 rgb(255 255 255 / 0.35);
+}
+.namelogo-a { left: 3%; top: -6%; }
+.namelogo-b { right: 3%; bottom: -10%; }
+.namelogo-flourish {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+.namelogo-line {
+  fill: none;
+  stroke: #c9a96e;
+  stroke-width: 1.6;
+  stroke-linecap: round;
+  stroke-dasharray: 1;
+  stroke-dashoffset: 0;
+}
+.namelogo-line-fine { stroke-width: 0.9; opacity: 0.7; }
+.namelogo-heart {
+  position: absolute;
+  left: 50%;
+  top: 56%;
+  width: 7%;
+  translate: -50% -50%;
+  fill: #c98a98;
+}
+.namelogo-fly {
+  position: absolute;
+  right: 6%;
+  top: 2%;
+  width: 13%;
+  height: auto;
+  rotate: 14deg;
+}
+
+/* wait: hidden until the reveal, but only when JavaScript can run it */
+.js .namelogo-wait .namelogo-name { clip-path: inset(-45% 100% -45% -12%); }
+.js .namelogo-wait .namelogo-line { stroke-dashoffset: 1; }
+.js .namelogo-wait .namelogo-heart { scale: 0; }
+.js .namelogo-wait .namelogo-fly { opacity: 0; }
+
+/* play: names left to right, the flourish draws, the heart, the butterfly */
+.namelogo-play .namelogo-name {
+  animation: nl-write 780ms cubic-bezier(0.4, 0, 0.2, 1) both;
+}
+.namelogo-play .namelogo-a { animation-delay: 150ms; }
+.namelogo-play .namelogo-b { animation-delay: 620ms; }
+.namelogo-play .namelogo-line {
+  animation: nl-draw 1000ms cubic-bezier(0.45, 0, 0.25, 1) 900ms both;
+}
+.namelogo-play .namelogo-line-fine { animation-delay: 1250ms; animation-duration: 700ms; }
+.namelogo-play .namelogo-heart {
+  animation: nl-heart 520ms cubic-bezier(0.34, 1.56, 0.64, 1) 1750ms both;
+}
+.namelogo-play .namelogo-fly {
+  animation: nl-fly 1300ms cubic-bezier(0.25, 0.7, 0.3, 1) 1950ms both;
+}
+/* The mask is bled far past the line box and taken off entirely at the end,
+   so no Khmer mark is ever left cut by it. */
+@keyframes nl-write {
+  0%   { clip-path: inset(-45% 100% -45% -12%); }
+  99%  { clip-path: inset(-45% -12% -45% -12%); }
+  100% { clip-path: none; }
+}
+@keyframes nl-draw {
+  from { stroke-dashoffset: 1; }
+  to   { stroke-dashoffset: 0; }
+}
+@keyframes nl-heart {
+  from { scale: 0; }
+  to   { scale: 1; }
+}
+@keyframes nl-fly {
+  0%   { opacity: 0; translate: 70% -90%; rotate: 40deg; }
+  55%  { opacity: 1; translate: -8% 6%; rotate: 6deg; }
+  78%  { translate: 4% -3%; rotate: 18deg; }
+  100% { opacity: 1; translate: 0 0; rotate: 14deg; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .namelogo-play .namelogo-name,
+  .namelogo-play .namelogo-line,
+  .namelogo-play .namelogo-heart,
+  .namelogo-play .namelogo-fly { animation-duration: 1ms !important; animation-delay: 0ms !important; }
+}
+
+/* ══ The cover ═══════════════════════════════════════════════════════════════
+ *
+ * Sized against the cover's own box with container units, so the whole
+ * composition fits one screen on a 1280×800 desktop and still balances on a
+ * short phone held sideways — nothing here reads the viewport.
+ */
+.cover-shell {
+  container-type: size;
+  padding: 3cqh 7%;
+}
+.cv {
+  position: relative;
+  z-index: 20;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  width: 100%;
+  max-width: 30rem;
+}
+.cv-crest {
+  width: clamp(48px, 11cqh, 104px);
+  height: auto;
+}
+.cv-title {
+  margin: 0.2cqh 0 0;
+  font-family: var(--f-heading), "Khmer OS Muol Light", serif;
+  font-weight: 400;
+  font-size: clamp(0.95rem, min(5.4cqw, 4.4cqh), 1.6rem);
+  line-height: 2.05;
+  color: rgb(var(--c-primary-rgb));
+}
+.cv-names {
+  width: min(80cqw, 40cqh, 360px);
+  margin: 0.4cqh 0 1.6cqh;
+}
+.cv-lead {
+  margin: 0;
+  font-size: clamp(0.74rem, 2.4cqh, 0.95rem);
+  line-height: 1.9;
+  color: rgb(var(--gold-1-rgb));
+}
+.cv-guest {
+  max-width: 94%;
+  margin: 0 0 1.4cqh;
+  font-family: var(--f-heading), "Khmer OS Muol Light", serif;
+  font-size: clamp(0.9rem, min(5cqw, 3.9cqh), 1.4rem);
+  line-height: 1.95;
+  color: rgb(var(--c-primary-rgb));
+}
+.cv-guest-latin {
+  font-family: "Cormorant Garamond", serif;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+.cv-date {
+  display: grid;
+  grid-template-columns: repeat(4, auto);
+  margin: 0;
+  border-block: 1px solid rgb(var(--gold-frame-rgb) / 0.5);
+}
+.cv-date-cell {
+  padding: 0.3cqh clamp(0.55rem, 3cqw, 1.2rem);
+  text-align: center;
+}
+.cv-date-cell + .cv-date-cell { border-left: 1px solid rgb(var(--gold-frame-rgb) / 0.45); }
+.cv-date-label {
+  font-size: clamp(0.6rem, 1.8cqh, 0.76rem);
+  line-height: 1.8;
+  color: rgb(var(--gold-1-rgb));
+}
+.cv-date-value {
+  margin: 0;
+  font-family: var(--f-heading), "Khmer OS Muol Light", serif;
+  font-size: clamp(0.8rem, min(3.8cqw, 3.4cqh), 1.15rem);
+  line-height: 2;
+  color: rgb(var(--c-primary-rgb));
+}
+.cv-time,
+.cv-venue {
+  margin: 0;
+  font-size: clamp(0.7rem, 2.3cqh, 0.9rem);
+  line-height: 1.9;
+  color: rgb(var(--c-text-rgb) / 0.85);
+}
+.cv-time { margin-top: 1.2cqh; }
+.cv-open { margin-top: 2.6cqh; }
+
+/* With the couple's photograph behind it, the writing turns light. */
+.cover-photo {
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  background:
+    linear-gradient(180deg, rgb(20 10 14 / 0.62) 0%, rgb(20 10 14 / 0.4) 42%, rgb(20 10 14 / 0.74) 100%),
+    var(--cover-photo) center / cover no-repeat;
+}
+.cover-on-photo .cv-title,
+.cover-on-photo .cv-guest,
+.cover-on-photo .cv-date-value { color: #fbf1f3; text-shadow: 0 1px 8px rgb(0 0 0 / 0.45); }
+.cover-on-photo .cv-lead,
+.cover-on-photo .cv-date-label { color: #ecd9b0; }
+.cover-on-photo .cv-time,
+.cover-on-photo .cv-venue { color: rgb(251 241 243 / 0.9); }
+.cover-on-photo .namelogo-name { color: #ecd9b0; text-shadow: 0 1px 8px rgb(0 0 0 / 0.5); }
+
+/* A short screen: the crest goes before anything that carries information. */
+@container (max-height: 420px) {
+  .cv-crest { display: none; }
+}
+
+/*
+ * A short landscape screen — a phone held sideways.
