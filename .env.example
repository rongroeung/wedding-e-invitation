# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the built-in embedded Postgres (PGlite),
# which stores data in ./.data — perfect for local development with zero setup.
# For production set a real PostgreSQL connection string (Neon, Supabase,
# Vercel Postgres, Railway, self-hosted …):
# DATABASE_URL="postgresql://user:password@host:5432/wedding?sslmode=require"
DATABASE_URL=""

# ── Security ────────────────────────────────────────────────────────────────
# Secret used to sign admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ── First admin account (created by `npm run db:seed`) ───────────────────────
ADMIN_EMAIL="admin@wedding.local"
ADMIN_PASSWORD="ChangeMe123!"

# ── Public site URL (used for QR codes, share links and Open Graph tags) ─────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
